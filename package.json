{
  "name": "oddfish",
  "private": true,
  "version": "1.0.0",
  "description": "Oddfish — the daily trivia game where rare answers catch rare fish",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "seed:sql": "esbuild scripts/export-seed.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.tmp/seed.cjs && node node_modules/.tmp/seed.cjs > supabase/seed.sql"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
